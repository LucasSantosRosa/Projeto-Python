 #USAR FUNÇOES DEF

     # Saudações e escolhas
Nome = input("Olá, para começarmos, digite seu nome:")
print (f"Olá, {Nome} agora podemos iniciar nossas contas básicas")

while True:
 print("\nMas antes eu preciso de saber qual das opções abaixo você gostaria de ver. Escolha uma destas:")
 print("1 - soma")
 print("2 - subtração")
 print("3 - multiplicar")
 print("4 - sair")
 opcao = (input("Qual?:"))
 if opcao == "1":
     # Apresentação da operação de soma
  while True:
   try:
    numeros = [float(x) for x in input("Vamos começar a aprender a operação de 'soma'. Insira dois números:").split()]
     # Necessário a função para que o usuário não quebre o código no cado de colocar mais de 2 numeros ou letras
    if len(numeros) != 2:
      print("Ops! Vamos começar apenas com dois números ok?")
    else:
     n1, n2 = numeros
     break
   except ValueError:
    print("Ops! Apenas números, não vamos fazer equações hoje haha!")
  print(f"Hm, então vou te mostrar aqui: {n1} + {n2} = {n1 + n2}")
    # Explicação final
  print(f"Quero te explicar melhor. Imagine que temos {n1} palitinhos e adicionamos mais {n2} palitinhos, assim podemos concluir um total de {n1 + n2} palitinhos!")
     # Apresentação da operação de subtração
 elif opcao == "2":
     # Apresentação da operação de subtração (IMPLEMENTAR CHANCE DE LETRA, LIMITE DE ALGARISMOS E FINALIZAR)
  n1, n2 = [float(y) for y in input("Beleza, quer começar pelas fáceis. Então me diga dois números:").split()]
  print(f"Fácil, veja só a conta primerio {n1} - {n2} = {n1 - n2}")

  # NAS PRÓXIMAS LINHAS IMPLEMENTE AS OPERAÇÕES DE MULTIPLICAÇÃO E DIVISÃO

